{
    "name": "ecem-react",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "axios": "^1.18.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-helmet-async": "^3.0.0",
        "react-router-dom": "^7.18.0",
        "react-scripts": "5.0.1"
    },
    "scripts": {
        "start": "react-scripts start",
        "build:app": "react-scripts build",
        "build": "npm run build:app && node scripts/react-snap.js",
        "test": "react-scripts test",
        "eject": "react-scripts eject"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "autoprefixer": "^10.5.2",
        "postcss": "^8.5.15",
        "react-snap": "^1.23.0",
        "tailwindcss": "^3.4.19"
    },
    "reactSnap": {
        "source": "build",
        "include": [
            "/",
            "/about",
            "/services",
            "/projects",
            "/clients",
            "/licenses",
            "/careers",
            "/contact"
        ],
        "skipThirdPartyRequests": true,
        "puppeteerArgs": [
            "--no-sandbox",
            "--disable-setuid-sandbox",
            "--disable-dev-shm-usage"
        ],
        "crawl": false
    }
}
